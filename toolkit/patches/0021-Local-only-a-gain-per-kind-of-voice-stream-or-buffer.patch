From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RicemanRhys <176650384+RicemanRhys@users.noreply.github.com>
Date: Sun, 4 Oct 2026 07:48:31 +0000
Subject: [PATCH] Local-only: a gain per kind of voice (stream or buffer) in
 the voice processor

mcpx_apu_set_voice_gain(stream, gain) scales every stream voice (music,
ambience, speech) or every buffer voice (effects) where the VP mixes a voice
into its bins. Multipass voices take none. 1.0, the default, leaves every
sample unchanged. For a player's music and effects volume (crash_twoc,
notes 18.58).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/apu/apu.h    |  7 +++++++
 src/apu/apu_vp.c | 25 ++++++++++++++++++++++++-
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/src/apu/apu.h b/src/apu/apu.h
index f7b9f8f..69e5323 100644
--- a/src/apu/apu.h
+++ b/src/apu/apu.h
@@ -31,6 +31,13 @@ void mcpx_apu_mmio_write(MCPXAPUState *d, uint64_t addr, uint64_t val, unsigned
  * Directly programs a voice without going through DirectSound. */
 void mcpx_apu_play_test_tone(MCPXAPUState *d);
 
+/* A gain (0.0-1.0) on every stream voice (stream != 0: music, ambience,
+ * speech) or every buffer voice (stream == 0: sound effects), applied where
+ * the voice processor mixes a voice into its bins. 1.0, the default, leaves
+ * the output unchanged. Any thread, any time. */
+void mcpx_apu_set_voice_gain(int stream, float gain);
+
+
 /* ============================================================
  * Software mixer - DirectSound buffer bridge
  *
diff --git a/src/apu/apu_vp.c b/src/apu/apu_vp.c
index 9590124..ccf7038 100644
--- a/src/apu/apu_vp.c
+++ b/src/apu/apu_vp.c
@@ -85,6 +85,21 @@ static bool voice_should_mute(uint16_t v)
     return m || mcpx_apu_debug_is_muted(v);
 }
 
+/* A gain per kind of voice, for a player's music and effects volume. The VP
+ * tells the two kinds apart by the format's data type: a stream voice plays
+ * buffers the title queues as it goes (DirectSound streams: music, ambience,
+ * speech), a buffer voice plays one buffer from memory (the sound effects).
+ * [0] buffer voices, [1] stream voices; 1.0 leaves every sample as it was.
+ * A multipass voice mixes bins other voices already wrote, so it takes none. */
+static volatile float g_voice_gain[2] = { 1.0f, 1.0f };
+
+void mcpx_apu_set_voice_gain(int stream, float gain)
+{
+    if (gain < 0.0f) gain = 0.0f;
+    if (gain > 1.0f) gain = 1.0f;
+    g_voice_gain[stream ? 1 : 0] = gain;
+}
+
 /* ============================================================
  * Utility functions
  * ============================================================ */
@@ -1186,6 +1201,13 @@ static void voice_process(MCPXAPUState *d,
         }
     }
 
+    /* The player's gain for this kind of voice (1.0: the samples unchanged) */
+    float kg = 1.0f;
+    if (!multipass) {
+        kg = g_voice_gain[voice_get_mask(d, v, NV_PAVS_VOICE_CFG_FMT,
+                                         NV_PAVS_VOICE_CFG_FMT_DATA_TYPE) != 0];
+    }
+
     /* Mix into bins */
     for (int b = 0; b < 8; b++) {
         float g = ea_value;
@@ -1196,6 +1218,7 @@ static void voice_process(MCPXAPUState *d,
             hr = (float)(1 << d->vp.submix_headroom[bin[b]]);
         }
         g *= attenuate(vol[b]) / hr;
+        g *= kg;
         for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
             mixbins[bin[b]][i] += g * samples[i][b % channels];
         }
@@ -1209,7 +1232,7 @@ static void voice_process(MCPXAPUState *d,
             float bg = attenuate(vol[b]) / hr;
             if (bg > g) g = bg;
         }
-        g *= ea_value;
+        g *= ea_value * kg;
         for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
             sample_buf[i][0] += g * samples[i][0];
             sample_buf[i][1] += g * samples[i][1];
