From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RicemanRhys <176650384+RicemanRhys@users.noreply.github.com>
Date: Thu, 1 Oct 2026 08:38:32 +0000
Subject: [PATCH] Local-only: the dot-product texture modes in the combiner
 shader

DOTPRODUCT, DOT_RFLCT_SPEC (texm3x3vspec), DOT_RFLCT_DIFF, DOT_STR_CUBE,
DOT_ST, DOT_STR_3D and DOT_ZW, as xemu's psh.c draws them: a stage dots
its texture coordinate's xyz with an earlier stage's texel (the input
texture, D3DRS_PSINPUTTEXTURE) expanded by its dot mapping
(D3DRS_PSDOTMAPPING, the -1..1 and 0..1 ones; HILO falls back to 0..1
as in xemu), and the group's last stage samples with those dots.
DOT_RFLCT_SPEC reflects the eye vector, the three coordinates' w, about
the normal. They had no mode, so stages 1-3 sampled nothing (the game's
water reflection pass added nothing).

Texture coordinates now go from every vertex shader to every pixel
shader as float4 (the eye vector is in w). All four stages change
together: with float3 texcoords on one side and float4 on the other,
the fixed-function pixel shader read its fog from the wrong register.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/d3d8_combiners.c | 127 +++++++++++++++++++++++++++++++--------
 src/d3d/d3d8_combiners.h |  25 ++++++++
 src/d3d/d3d8_shaders.c   |  32 +++++-----
 src/d3d/d3d8_vsh.c       |  16 ++---
 4 files changed, 151 insertions(+), 49 deletions(-)

diff --git a/src/d3d/d3d8_combiners.c b/src/d3d/d3d8_combiners.c
index 30b07e1..c44984d 100644
--- a/src/d3d/d3d8_combiners.c
+++ b/src/d3d/d3d8_combiners.c
@@ -287,6 +287,22 @@ void d3d8_combiners_from_render_states(const DWORD *rs,
     state->final_c0 = state->c0[state->num_stages > 0 ? state->num_stages - 1 : 0];
     state->final_c1 = state->c1[state->num_stages > 0 ? state->num_stages - 1 : 0];
 
+    /* Dot-product stages, in the XDK's layout (PS_DOTMAPPING and
+     * PS_INPUTTEXTURE): mappings for stages 1-3 in bits 0, 4 and 8; the
+     * input stage for stage 2 in bit 16, for stage 3 in bits 20-21. */
+    {
+        DWORD dm = rs[D3DRS_PSDOTMAPPING], it = rs[D3DRS_PSINPUTTEXTURE];
+
+        state->dot_map[0] = 0;
+        state->dot_map[1] = (int)(dm & 0xF);
+        state->dot_map[2] = (int)((dm >> 4) & 0xF);
+        state->dot_map[3] = (int)((dm >> 8) & 0xF);
+        state->input_tex[0] = 0;
+        state->input_tex[1] = 0;
+        state->input_tex[2] = (int)((it >> 16) & 0x1);
+        state->input_tex[3] = (int)((it >> 20) & 0x3);
+    }
+
     /* Read texture modes from render state if not already set by token */
     if (state->tex_mode[0] == 0 && state->tex_mode[1] == 0 &&
         state->tex_mode[2] == 0 && state->tex_mode[3] == 0) {
@@ -491,19 +507,40 @@ int d3d8_combiners_generate_hlsl(const NV2ACombinerState *state,
 
     /* ---- Texture samplers ---- */
     for (i = 0; i < NV2A_MAX_TEXTURES; i++) {
-        if (state->tex_mode[i] != NV2A_TEXMODE_NONE) {
-            if (state->tex_mode[i] == NV2A_TEXMODE_CUBEMAP) {
-                EMIT("TextureCube  tex%d : register(t%d);\n", i, i);
-            } else if (state->tex_mode[i] == NV2A_TEXMODE_3D) {
-                EMIT("Texture3D    tex%d : register(t%d);\n", i, i);
-            } else {
-                EMIT("Texture2D    tex%d : register(t%d);\n", i, i);
-            }
-            EMIT("SamplerState samp%d : register(s%d);\n", i, i);
+        switch (state->tex_mode[i]) {
+        case NV2A_TEXMODE_NONE:
+        case NV2A_TEXMODE_DOTPRODUCT:
+        case NV2A_TEXMODE_DOT_ZW:
+            continue;                   /* samples nothing */
+        case NV2A_TEXMODE_CUBEMAP:
+        case NV2A_TEXMODE_DOT_RFLCT_SPEC:
+        case NV2A_TEXMODE_DOT_RFLCT_DIFF:
+        case NV2A_TEXMODE_DOT_STR_CUBE:
+            EMIT("TextureCube  tex%d : register(t%d);\n", i, i);
+            break;
+        case NV2A_TEXMODE_3D:
+        case NV2A_TEXMODE_DOT_STR_3D:
+            EMIT("Texture3D    tex%d : register(t%d);\n", i, i);
+            break;
+        default:
+            EMIT("Texture2D    tex%d : register(t%d);\n", i, i);
+            break;
         }
+        EMIT("SamplerState samp%d : register(s%d);\n", i, i);
     }
     EMIT("\n");
 
+    /* The dot mappings: a texel's rgb expanded as the NV2A does before a
+     * dot-product stage uses it (xemu's sign1/sign2/sign3). The HILO
+     * mappings (4-7) fall back to 0..1, as xemu's do. */
+    EMIT("float nv_sign1(float x) { x *= 255.0; return (x - 128.0) / 127.0; }\n");
+    EMIT("float nv_sign2(float x) { x *= 255.0; return x >= 128.0 ? (x - 255.5) / 127.5 : (x + 0.5) / 127.5; }\n");
+    EMIT("float nv_sign3(float x) { x *= 255.0; return x >= 128.0 ? (x - 256.0) / 127.0 : x / 127.0; }\n");
+    EMIT("float3 dotmap0(float4 c) { return c.rgb; }\n");
+    EMIT("float3 dotmap1(float4 c) { return float3(nv_sign1(c.r), nv_sign1(c.g), nv_sign1(c.b)); }\n");
+    EMIT("float3 dotmap2(float4 c) { return float3(nv_sign2(c.r), nv_sign2(c.g), nv_sign2(c.b)); }\n");
+    EMIT("float3 dotmap3(float4 c) { return float3(nv_sign3(c.r), nv_sign3(c.g), nv_sign3(c.b)); }\n\n");
+
     /* ---- Constant buffer ---- */
     EMIT("cbuffer CombinerCB : register(b0) {\n");
     EMIT("    float4 c0[8];\n");    /* Per-stage C0 */
@@ -525,10 +562,10 @@ int d3d8_combiners_generate_hlsl(const NV2ACombinerState *state,
     EMIT("    float4 pos     : SV_POSITION;\n");
     EMIT("    float4 color0  : COLOR0;\n");
     EMIT("    float4 color1  : COLOR1;\n");
-    EMIT("    float3 tc0     : TEXCOORD0;\n");
-    EMIT("    float3 tc1     : TEXCOORD1;\n");
-    EMIT("    float3 tc2     : TEXCOORD2;\n");
-    EMIT("    float3 tc3     : TEXCOORD3;\n");
+    EMIT("    float4 tc0     : TEXCOORD0;\n");
+    EMIT("    float4 tc1     : TEXCOORD1;\n");
+    EMIT("    float4 tc2     : TEXCOORD2;\n");
+    EMIT("    float4 tc3     : TEXCOORD3;\n");
     EMIT("    float  fog     : TEXCOORD4;\n");   /* vertex fog: the factor */
     EMIT("    float4 viewpos : TEXCOORD5;\n");   /* table fog: view-space position */
     EMIT("};\n\n");
@@ -562,24 +599,64 @@ int d3d8_combiners_generate_hlsl(const NV2ACombinerState *state,
     EMIT("    float4 r_v0   = input.color0;\n");
     EMIT("    float4 r_v1   = input.color1;\n");
 
-    /* Texture samples */
+    /* Texture samples. A dot-product stage dots its coordinate's xyz with
+     * an earlier stage's texel (input_tex), expanded by its dot mapping;
+     * the later stages of the group sample with those dots (xemu psh.c). */
+    EMIT("    float dot1 = 0.0, dot2 = 0.0, dot3 = 0.0, dot2n = 0.0;\n");
     for (i = 0; i < NV2A_MAX_TEXTURES; i++) {
-        if (state->tex_mode[i] == NV2A_TEXMODE_NONE) {
+        int dm = state->dot_map[i] >= 0 && state->dot_map[i] <= 3 ? state->dot_map[i] : 0;
+        int in = state->input_tex[i] >= 0 && state->input_tex[i] < i ? state->input_tex[i] : 0;
+        NV2ATextureMode mode = state->tex_mode[i];
+
+        if (i == 0 && mode >= NV2A_TEXMODE_DOTPRODUCT)
+            mode = NV2A_TEXMODE_NONE;   /* no dot product on stage 0 */
+        if (i == 1 && mode != NV2A_TEXMODE_DOTPRODUCT && mode >= NV2A_TEXMODE_DOTPRODUCT)
+            mode = NV2A_TEXMODE_DOTPRODUCT;     /* stage 1 can only dot (the others need earlier dots) */
+        if (mode >= NV2A_TEXMODE_DOTPRODUCT)
+            EMIT("    dot%d = dot(input.tc%d.xyz, dotmap%d(r_t%d));\n", i, i, dm, in);
+        switch (mode) {
+        case NV2A_TEXMODE_NONE:
+        case NV2A_TEXMODE_DOTPRODUCT:
+        case NV2A_TEXMODE_DOT_ZW:
             EMIT("    float4 r_t%d = float4(0, 0, 0, 0);\n", i);
-        } else if (state->tex_mode[i] == NV2A_TEXMODE_CUBEMAP) {
+            break;
+        case NV2A_TEXMODE_CUBEMAP:
             /* Cube map: use the full 3-component reflection/TCI vector */
-            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, input.tc%d);\n",
-                 i, i, i, i);
-        } else if (state->tex_mode[i] == NV2A_TEXMODE_3D) {
+            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, input.tc%d.xyz);\n", i, i, i, i);
+            break;
+        case NV2A_TEXMODE_3D:
             /* 3D texture: use the full 3-component coordinate */
-            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, input.tc%d);\n",
-                 i, i, i, i);
-        } else {
-            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, input.tc%d.xy);\n",
-                 i, i, i, i);
+            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, input.tc%d.xyz);\n", i, i, i, i);
+            break;
+        case NV2A_TEXMODE_DOT_ST:
+            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, float2(dot%d, dot%d));\n", i, i, i, i - 1, i);
+            break;
+        case NV2A_TEXMODE_DOT_RFLCT_DIFF: {
+            /* The normal's third component dots stage 3's coordinate. */
+            int dm3 = state->dot_map[3] >= 0 && state->dot_map[3] <= 3 ? state->dot_map[3] : 0;
+            int in3 = state->input_tex[3] >= 0 && state->input_tex[3] < i ? state->input_tex[3] : 0;
+            EMIT("    dot2n = dot(input.tc3.xyz, dotmap%d(r_t%d));\n", dm3, in3);
+            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, float3(dot1, dot2, dot2n));\n", i, i, i);
+            break;
+        }
+        case NV2A_TEXMODE_DOT_RFLCT_SPEC:
+            /* The eye vector is the three coordinates' w; the cube is
+             * sampled at it reflected about the normal (dot1, dot2, dot3). */
+            EMIT("    float3 n_%d = float3(dot1, dot2, dot3);\n", i);
+            EMIT("    float3 e_%d = float3(input.tc1.w, input.tc2.w, input.tc3.w);\n", i);
+            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, 2.0 * n_%d * dot(n_%d, e_%d) / dot(n_%d, n_%d) - e_%d);\n",
+                 i, i, i, i, i, i, i, i, i);
+            break;
+        case NV2A_TEXMODE_DOT_STR_CUBE:
+        case NV2A_TEXMODE_DOT_STR_3D:
+            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, float3(dot1, dot2, dot3));\n", i, i, i);
+            break;
+        default:
+            EMIT("    float4 r_t%d = tex%d.Sample(samp%d, input.tc%d.xy);\n", i, i, i, i);
+            break;
         }
         /* Preserve disabled stages and sampled alpha. */
-        if (state->tex_mode[i] != NV2A_TEXMODE_NONE)
+        if (mode != NV2A_TEXMODE_NONE && mode != NV2A_TEXMODE_DOTPRODUCT && mode != NV2A_TEXMODE_DOT_ZW)
             EMIT("    if (alpha_only[%d]) r_t%d.rgb = 1.0;\n", i, i);
     }
 
diff --git a/src/d3d/d3d8_combiners.h b/src/d3d/d3d8_combiners.h
index 5f3b6a6..23c23c5 100644
--- a/src/d3d/d3d8_combiners.h
+++ b/src/d3d/d3d8_combiners.h
@@ -138,8 +138,27 @@ typedef enum NV2ATextureMode {
     NV2A_TEXMODE_3D      = 1,  /* 3D / volume texture */
     NV2A_TEXMODE_CUBEMAP = 2,  /* Cube map */
     NV2A_TEXMODE_NONE    = 3,  /* No texture bound */
+    /* The dot-product modes (PS_TEXTUREMODES_*, as xemu's psh.c draws
+     * them). Each dots its texture coordinate's xyz with an earlier
+     * stage's texel, expanded by that stage's dot mapping. */
+    NV2A_TEXMODE_DOTPRODUCT     = 4,  /* stage 1 or 2: a dot product; samples nothing (t = 0) */
+    NV2A_TEXMODE_DOT_RFLCT_SPEC = 5,  /* stage 3: cube at the eye vector reflected about (dot1, dot2, dot3) */
+    NV2A_TEXMODE_DOT_RFLCT_DIFF = 6,  /* stage 2: cube at (dot1, dot2, dot of stage 3's coordinate) */
+    NV2A_TEXMODE_DOT_STR_CUBE   = 7,  /* stage 3: cube at (dot1, dot2, dot3) */
+    NV2A_TEXMODE_DOT_ST         = 8,  /* stage 2: 2D at (dot1, dot2) */
+    NV2A_TEXMODE_DOT_STR_3D     = 9,  /* stage 3: 3D at (dot1, dot2, dot3) */
+    NV2A_TEXMODE_DOT_ZW         = 10, /* stage 2 or 3: a dot product for depth (not drawn: t = 0) */
 } NV2ATextureMode;
 
+/* PS_DOTMAPPING_*: how a dot-product stage expands its input texel. */
+typedef enum NV2ADotMapping {
+    NV2A_DOTMAP_ZERO_TO_ONE     = 0,
+    NV2A_DOTMAP_MINUS1_TO_1_D3D = 1,
+    NV2A_DOTMAP_MINUS1_TO_1_GL  = 2,
+    NV2A_DOTMAP_MINUS1_TO_1     = 3,
+    /* 4-7: the HILO mappings (16-bit signed or unsigned pairs) */
+} NV2ADotMapping;
+
 /* ================================================================
  * Combiner Stage Input / Output Descriptors
  * ================================================================ */
@@ -227,6 +246,12 @@ typedef struct NV2ACombinerState {
     /* --- Texture modes --- */
     NV2ATextureMode tex_mode[NV2A_MAX_TEXTURES];
 
+    /* --- Dot-product stages (D3DRS_PSDOTMAPPING, D3DRS_PSINPUTTEXTURE) ---
+     * dot_map[s]: stage s's NV2ADotMapping (stages 1-3); input_tex[s]:
+     * the stage whose texel it dots with (stage 1 always 0). */
+    int dot_map[NV2A_MAX_TEXTURES];
+    int input_tex[NV2A_MAX_TEXTURES];
+
     /* --- Flags --- */
     DWORD flags;     /* Dot mapping and other flags from token bits 24-31 */
 } NV2ACombinerState;
diff --git a/src/d3d/d3d8_shaders.c b/src/d3d/d3d8_shaders.c
index baab591..33f1862 100644
--- a/src/d3d/d3d8_shaders.c
+++ b/src/d3d/d3d8_shaders.c
@@ -87,10 +87,10 @@ static const char g_vs_source[] =
     "    float4 pos      : SV_POSITION;\n"
     "    float4 diffuse  : COLOR0;\n"
     "    float4 specular : COLOR1;\n"
-    "    float3 tex0     : TEXCOORD0;\n"
-    "    float3 tex1     : TEXCOORD1;\n"
-    "    float3 tex2     : TEXCOORD2;\n"
-    "    float3 tex3     : TEXCOORD3;\n"
+    "    float4 tex0     : TEXCOORD0;\n"
+    "    float4 tex1     : TEXCOORD1;\n"
+    "    float4 tex2     : TEXCOORD2;\n"
+    "    float4 tex3     : TEXCOORD3;\n"
     "    float  fog      : TEXCOORD4;\n"
     "    float4 viewpos  : TEXCOORD5;\n"   /* view-space position (per-pixel fog) */
     "};\n"
@@ -160,10 +160,10 @@ static const char g_vs_source[] =
      * RHW = 0 is degenerate and titles do emit it for 2D overlays that do not
      * care; dividing by it culls the whole quad, so leave those alone. */
     "        if (input.pos.w != 0.0) o.pos /= input.pos.w;\n"
-    "        o.tex0 = input.tex0.xyz;\n"
-    "        o.tex1 = input.tex1.xyz;\n"
-    "        o.tex2 = input.tex2.xyz;\n"
-    "        o.tex3 = input.tex3.xyz;\n"
+    "        o.tex0 = input.tex0;\n"
+    "        o.tex1 = input.tex1;\n"
+    "        o.tex2 = input.tex2;\n"
+    "        o.tex3 = input.tex3;\n"
     "        o.diffuse = (Flags & FLAG_HAS_DIFFUSE) ? input.diffuse.bgra : float4(1,1,1,1);\n"
     "        if (Flags & FLAG_HAS_SPECULAR) o.specular = input.specular.bgra;\n"
     "        return o;\n"
@@ -188,10 +188,10 @@ static const char g_vs_source[] =
     "    }\n"
     "\n"
     "    // Texture coordinates: per-stage TEXCOORDINDEX + texture matrix\n"
-    "    o.tex0 = gen_tex(0, input, posCam, nrmCam).xyz;\n"
-    "    o.tex1 = gen_tex(1, input, posCam, nrmCam).xyz;\n"
-    "    o.tex2 = gen_tex(2, input, posCam, nrmCam).xyz;\n"
-    "    o.tex3 = gen_tex(3, input, posCam, nrmCam).xyz;\n"
+    "    o.tex0 = gen_tex(0, input, posCam, nrmCam);\n"
+    "    o.tex1 = gen_tex(1, input, posCam, nrmCam);\n"
+    "    o.tex2 = gen_tex(2, input, posCam, nrmCam);\n"
+    "    o.tex3 = gen_tex(3, input, posCam, nrmCam);\n"
     "\n"
     "    // Lighting\n"
     "    if ((Flags & FLAG_LIGHTING) && (Flags & FLAG_HAS_NORMAL)) {\n"
@@ -283,10 +283,10 @@ static const char g_ps_body[] =
     "    float4 pos      : SV_POSITION;\n"
     "    float4 diffuse  : COLOR0;\n"
     "    float4 specular : COLOR1;\n"
-    "    float3 tex0     : TEXCOORD0;\n"
-    "    float3 tex1     : TEXCOORD1;\n"
-    "    float3 tex2     : TEXCOORD2;\n"
-    "    float3 tex3     : TEXCOORD3;\n"
+    "    float4 tex0     : TEXCOORD0;\n"
+    "    float4 tex1     : TEXCOORD1;\n"
+    "    float4 tex2     : TEXCOORD2;\n"
+    "    float4 tex3     : TEXCOORD3;\n"
     "    float  fog      : TEXCOORD4;\n"
     "    float4 viewpos  : TEXCOORD5;\n"
     "};\n"
diff --git a/src/d3d/d3d8_vsh.c b/src/d3d/d3d8_vsh.c
index 4b187a4..62f5b97 100644
--- a/src/d3d/d3d8_vsh.c
+++ b/src/d3d/d3d8_vsh.c
@@ -494,10 +494,10 @@ int d3d8_vsh_generate_hlsl(const NV2AVshProgram *program,
         "    float4 pos      : SV_POSITION;\n"
         "    float4 diffuse  : COLOR0;\n"
         "    float4 specular : COLOR1;\n"
-        "    float3 tex0     : TEXCOORD0;\n"
-        "    float3 tex1     : TEXCOORD1;\n"
-        "    float3 tex2     : TEXCOORD2;\n"
-        "    float3 tex3     : TEXCOORD3;\n"
+        "    float4 tex0     : TEXCOORD0;\n"
+        "    float4 tex1     : TEXCOORD1;\n"
+        "    float4 tex2     : TEXCOORD2;\n"
+        "    float4 tex3     : TEXCOORD3;\n"
         "    float  fog      : TEXCOORD4;\n"
         "    float4 viewpos  : TEXCOORD5;\n"
         "};\n\n"
@@ -557,10 +557,10 @@ int d3d8_vsh_generate_hlsl(const NV2AVshProgram *program,
         "    o.pos = float4((oPos.xyz - c[59].xyz) / vs * oPos.w, oPos.w);\n"
         "    o.diffuse  = saturate(oD0);\n"
         "    o.specular = saturate(oD1);\n"
-        "    o.tex0 = oT0.xyz;\n"
-        "    o.tex1 = oT1.xyz;\n"
-        "    o.tex2 = oT2.xyz;\n"
-        "    o.tex3 = oT3.xyz;\n"
+        "    o.tex0 = oT0;\n"
+        "    o.tex1 = oT1;\n"
+        "    o.tex2 = oT2;\n"
+        "    o.tex3 = oT3;\n"
         "    o.fog = saturate(oFog.x);\n"          /* vertex fog: the factor */
         "    o.viewpos = float4(0.0, 0.0, oFog.x, 1.0);\n"   /* table fog: the NV2A fogs from oFog.x */
         "    return o;\n"
