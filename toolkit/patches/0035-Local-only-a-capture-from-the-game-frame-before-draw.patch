From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RicemanRhys <176650384+RicemanRhys@users.noreply.github.com>
Date: Tue, 20 Oct 2026 00:01:25 +0000
Subject: [PATCH] Local-only: a capture from the game frame before drawn again
 with this draw's geometry and constants, and captured (d3d8_DrawBakedAgain;
 perf only, the same pixels; twoc step 95 cut 3)

- d3d8_DrawBakedAgain(old, now, srv, ff_m, prim, counts, idx, verts, stride, kept): `old`, a capture of the frame before for a draw the caller knows is in the same state, drawn with this draw's own vertices and indices (put in the rings as the UP draws put them, fans and quads made lists, `kept` as theirs: a kept position the rings still hold is drawn from), its program constants as the caller's SetVertexShaderConstant calls left them (d3d8_vsh_bake_again: a capturing draw's ring step, the block before when they haven't changed) or its fixed-function matrices (d3d8_shaders_bake_again: the transform block made again with them, the lighting and pixel blocks copied into this frame's memory; d3d8_combiners_bake_again for the combiners'), and captured into `now` for this frame's later passes. S_FALSE when `old` no longer holds. DrawBaked's binding and draw shared (baked_draw).
- The bake's memory alternates between two sets, so the frame before's captures stay readable through this one.
- d3d8_BakeReset starts the rings over by a slowly falling peak of the frames' uploads (1/256 a frame) rather than the last frame's alone: with most geometry drawn from where the rings held it the frame before, a frame uploads little until the rings start over and then all of it, and the last frame alone let a ring fill up in the middle of a frame (its later passes then drawn the ordinary way).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/d3d8_combiners.c |  17 ++++++
 src/d3d/d3d8_device.c    | 112 ++++++++++++++++++++++++++++++++++++---
 src/d3d/d3d8_internal.h  |  19 +++++++
 src/d3d/d3d8_shaders.c   |  24 +++++++++
 src/d3d/d3d8_vsh.c       |  43 +++++++++++++++
 5 files changed, 209 insertions(+), 6 deletions(-)

diff --git a/src/d3d/d3d8_combiners.c b/src/d3d/d3d8_combiners.c
index 176473c..0459494 100644
--- a/src/d3d/d3d8_combiners.c
+++ b/src/d3d/d3d8_combiners.c
@@ -1245,6 +1245,23 @@ const void *d3d8_combiners_bake(UINT *bytes)
     return p;
 }
 
+/* Twoc step 95 (cut 3): a capture's combiner constants from the game frame
+ * before, copied into this frame's bake memory (the frame's last capture's
+ * when the same). */
+const void *d3d8_combiners_bake_again(const void *old)
+{
+    void *p;
+
+    if (g_cb_captured && memcmp(g_cb_captured, old, sizeof(g_cb_held)) == 0)
+        return g_cb_captured;
+    p = d3d8_bake_alloc(sizeof(g_cb_held));
+    if (p) {
+        memcpy(p, old, sizeof(g_cb_held));
+        g_cb_captured = p;
+    }
+    return p;
+}
+
 /* A baked draw's combiner constants into the buffer, unless it holds them. */
 void d3d8_combiners_baked_upload(const void *consts)
 {
diff --git a/src/d3d/d3d8_device.c b/src/d3d/d3d8_device.c
index 8b0573e..116d1a3 100644
--- a/src/d3d/d3d8_device.c
+++ b/src/d3d/d3d8_device.c
@@ -1136,14 +1136,18 @@ HRESULT d3d8_DrawIndexedPrimitiveUPKept(D3DPRIMITIVETYPE PrimitiveType, UINT Num
 }
 
 /* The bake's memory: chunks kept from frame to frame, emptied at
- * d3d8_BakeReset. */
+ * d3d8_BakeReset. Twoc step 95 (cut 3): two sets in turn, a capturing
+ * frame's and the one before's, so a capture from the frame before stays
+ * readable while this one draws it again (d3d8_DrawBakedAgain). */
 typedef struct bake_chunk {
     struct bake_chunk *next;
     size_t used, cap;
     double data[1];
 } bake_chunk;
 #define BAKE_CHUNK (256u * 1024u)
-static bake_chunk *g_bake_head, *g_bake_cur;
+static bake_chunk *g_bake_heads[2], *g_bake_cur;
+static int g_bake_set;
+#define g_bake_head g_bake_heads[g_bake_set]
 
 void *d3d8_bake_alloc(size_t n)
 {
@@ -1184,11 +1188,20 @@ void d3d8_BakeReset(void)
      * cast_bug): one that may not hold this frame's uploads after the last
      * frame's (with a quarter more and 1 MB) starts over at its next upload,
      * here at the frame's start. */
-    if ((UINT64)g_up_ring_offset + g_up_frame_bytes + g_up_frame_bytes / 4 + (1u << 20) > UP_RING_BUFFER_SIZE)
+    /* Twoc step 95: by a slowly falling peak of the frames' uploads rather
+     * than the last frame's alone. Draws drawn again from where the rings
+     * held them the frame before (twoc's cut 3) upload little most frames and
+     * all of it after the rings start over, so the last frame alone let a
+     * ring fill up in the middle of a frame now and then. */
+    static UINT up_peak, ib_peak;
+    up_peak = g_up_frame_bytes > up_peak - up_peak / 256 ? g_up_frame_bytes : up_peak - up_peak / 256;
+    ib_peak = g_ib_frame_bytes > ib_peak - ib_peak / 256 ? g_ib_frame_bytes : ib_peak - ib_peak / 256;
+    if ((UINT64)g_up_ring_offset + up_peak + up_peak / 4 + (1u << 20) > UP_RING_BUFFER_SIZE)
         g_up_ring_offset = UP_RING_BUFFER_SIZE;
-    if ((UINT64)g_ib_ring_offset + g_ib_frame_bytes + g_ib_frame_bytes / 4 + (1u << 20) > IB_RING_BUFFER_SIZE)
+    if ((UINT64)g_ib_ring_offset + ib_peak + ib_peak / 4 + (1u << 20) > IB_RING_BUFFER_SIZE)
         g_ib_ring_offset = IB_RING_BUFFER_SIZE;
     g_up_frame_bytes = g_ib_frame_bytes = 0;
+    g_bake_set ^= 1;                    /* the frame before's set kept (cut 3) */
     for (c = g_bake_head; c; c = c->next)
         c->used = 0;
     g_bake_cur = g_bake_head;
@@ -1208,12 +1221,12 @@ void d3d8_BakeCapture(D3D8Baked *b)
     g_bake_cap = b;
 }
 
+static void baked_draw(ID3D11DeviceContext *ctx, const D3D8Baked *b, ID3D11ShaderResourceView *const srv[4]);
+
 HRESULT d3d8_DrawBaked(const D3D8Baked *b, ID3D11ShaderResourceView *const srv[4], const float *const *vs_blk,
                        BOOL fresh, const D3DMATRIX *const ff_m[3])
 {
     ID3D11DeviceContext *ctx = g_device_state.d3d11_context;
-    static const float blend_factor[4] = { 1, 1, 1, 1 };
-    DWORD s;
 
     if (!b->gen || b->gen != d3d8_bake_gen || b->ring_gen != g_ring_gen || (b->vsh && !vs_blk))
         return S_FALSE;
@@ -1227,6 +1240,17 @@ HRESULT d3d8_DrawBaked(const D3D8Baked *b, ID3D11ShaderResourceView *const srv[4
         d3d8_bind_vs_cb(ctx, 1, b->vs_cb[1]);
     }
     d3d8_shaders_baked_upload(b, ff_m); /* the fixed-function and pixel constants */
+    baked_draw(ctx, b, srv);
+    return S_OK;
+}
+
+/* A baked draw's pixel shader, its states, samplers, views and viewport
+ * bound and the draw made (d3d8_DrawBaked, d3d8_DrawBakedAgain). */
+static void baked_draw(ID3D11DeviceContext *ctx, const D3D8Baked *b, ID3D11ShaderResourceView *const srv[4])
+{
+    static const float blend_factor[4] = { 1, 1, 1, 1 };
+    DWORD s;
+
     d3d8_bind_ps(ctx, b->ps);
     d3d8_bind_ps_cb(ctx, b->ps_cb);
     if (g_d3d8_bound.bs != b->bs) {     /* as d3d8_states_apply binds them */
@@ -1257,6 +1281,82 @@ HRESULT d3d8_DrawBaked(const D3D8Baked *b, ID3D11ShaderResourceView *const srv[4
         ID3D11DeviceContext_DrawIndexed(ctx, b->count, b->start, b->base);
     else
         ID3D11DeviceContext_Draw(ctx, b->count, b->start);
+}
+
+HRESULT d3d8_DrawBakedAgain(const D3D8Baked *old, D3D8Baked *now, ID3D11ShaderResourceView *const srv[4],
+                            const D3DMATRIX *const ff_m[3], D3DPRIMITIVETYPE pt, UINT prim_count, UINT nverts,
+                            const void *idx, const void *verts, UINT stride, D3D8UpKept *kept)
+{
+    ID3D11DeviceContext *ctx = g_device_state.d3d11_context;
+    D3D11_PRIMITIVE_TOPOLOGY topology;
+    UINT count, vb_offset, ib_offset = 0;
+    void *converted = NULL;
+
+    if (!old->gen || old->gen != d3d8_bake_gen || !verts || !stride ||
+        stride != old->stride || (idx != NULL) != (old->ib_format != DXGI_FORMAT_UNKNOWN))
+        return S_FALSE;
+    topology = map_primitive_type(pt, prim_count, &count);
+    if (!count || topology != old->topology)
+        return S_FALSE;
+    /* The vertices and indices as the UP draws upload them (with `kept`). */
+    if (kept && kept->gen == g_ring_gen) {
+        vb_offset = kept->vb_offset;
+        ib_offset = kept->ib_offset;
+    } else if (idx) {
+        vb_offset = up_ring_upload(verts, nverts * stride, stride);
+        if (vb_offset == (UINT)-1)
+            return S_FALSE;
+        ib_offset = ib_ring_upload(idx, count * 2);
+        if (ib_offset == (UINT)-1)
+            return S_FALSE;
+        if (kept) {
+            kept->gen = g_ring_gen;
+            kept->vb_offset = vb_offset;
+            kept->ib_offset = ib_offset;
+        }
+    } else {
+        const void *data = verts;
+        UINT n = count;
+        if (pt == D3DPT_TRIANGLEFAN || pt == D3DPT_QUADLIST) {
+            converted = convert_fan_or_quad(pt, verts, prim_count, stride, &n);
+            if (converted)
+                data = converted;
+        }
+        vb_offset = up_ring_upload(data, n * stride, stride);
+        if (converted)
+            free(converted);
+        if (vb_offset == (UINT)-1)
+            return S_FALSE;
+        if (kept) {
+            kept->gen = g_ring_gen;
+            kept->vb_offset = vb_offset;
+        }
+    }
+    *now = *old;
+    now->ring_gen = g_ring_gen;
+    now->count = count;
+    if (idx) {
+        now->start = ib_offset / 2;
+        now->base = (INT)(vb_offset / stride);
+    } else {
+        now->start = vb_offset / stride;
+        now->base = 0;
+    }
+    if (!d3d8_shaders_bake_again(now, ff_m)) {  /* its constant blocks in this frame's memory */
+        now->gen = 0;
+        return S_FALSE;
+    }
+    g_d3d_draw_count++;
+    d3d8_bind_vs(ctx, now->vs);
+    d3d8_bind_layout(ctx, now->il);
+    if (now->vsh) {
+        d3d8_vsh_bake_again(now);       /* as a capturing draw's: the ring's block, `now` told where */
+    } else {
+        d3d8_bind_vs_cb(ctx, 0, now->vs_cb[0]);
+        d3d8_bind_vs_cb(ctx, 1, now->vs_cb[1]);
+    }
+    d3d8_shaders_baked_upload(now, NULL);
+    baked_draw(ctx, now, srv);
     return S_OK;
 }
 
diff --git a/src/d3d/d3d8_internal.h b/src/d3d/d3d8_internal.h
index 57d5ab6..f55ce34 100644
--- a/src/d3d/d3d8_internal.h
+++ b/src/d3d/d3d8_internal.h
@@ -636,8 +636,27 @@ void d3d8_BakeCapture(D3D8Baked *b);
 HRESULT d3d8_DrawBaked(const D3D8Baked *b, ID3D11ShaderResourceView *const srv[4], const float *const *vs_blk,
                        BOOL fresh, const D3DMATRIX *const ff_m[3]);
 
+/* Twoc step 95 (cut 3): `old`, a capture made in the game frame before (the
+ * bake's memory holds the last two frames'), of a draw whose translation
+ * the caller knows to be this one's (the same render and stage states,
+ * shaders, lights and material, viewport, target, primitive and stride),
+ * drawn again with this draw's own vertices and indices (put in the rings
+ * as DrawPrimitiveUP / DrawIndexedPrimitiveUP put them, `kept` as theirs:
+ * `idx` 16-bit, NULL not indexed; `nverts` the vertices at `verts`), its
+ * program constants as SetVertexShaderConstant left them (the caller sets
+ * them first, as for an ordinary draw) or its fixed-function matrices
+ * (`ff_m`), and stage s sampling srv[s]; and captured into `now` for this
+ * frame's later passes. Returns S_FALSE without drawing when `old` no
+ * longer holds (draw it the ordinary way). */
+HRESULT d3d8_DrawBakedAgain(const D3D8Baked *old, D3D8Baked *now, ID3D11ShaderResourceView *const srv[4],
+                            const D3DMATRIX *const ff_m[3], D3DPRIMITIVETYPE pt, UINT prim_count, UINT nverts,
+                            const void *idx, const void *verts, UINT stride, D3D8UpKept *kept);
+
 /* The modules' parts (d3d8_shaders.c, d3d8_combiners.c, d3d8_vsh.c) */
 void *d3d8_bake_alloc(size_t n);
+int d3d8_shaders_bake_again(D3D8Baked *b, const D3DMATRIX *const ff_m[3]);
+const void *d3d8_combiners_bake_again(const void *old);
+void d3d8_vsh_bake_again(D3D8Baked *b);
 void d3d8_shaders_bake(D3D8Baked *b);
 void d3d8_shaders_baked_upload(const D3D8Baked *b, const D3DMATRIX *const ff_m[3]);
 void d3d8_shaders_bake_reset(void);
diff --git a/src/d3d/d3d8_shaders.c b/src/d3d/d3d8_shaders.c
index a719b33..6b84c85 100644
--- a/src/d3d/d3d8_shaders.c
+++ b/src/d3d/d3d8_shaders.c
@@ -1288,6 +1288,30 @@ void d3d8_shaders_bake(D3D8Baked *b)
     b->gen = d3d8_bake_gen;
 }
 
+/* Twoc step 95 (cut 3): `b`, a copy of a capture from the game frame before
+ * (d3d8_DrawBakedAgain), made this frame's: a fixed-function draw's
+ * transform block made again with `ff_m`'s matrices (the rest of it is the
+ * draw's states', as captured) and its lighting block, and the pixel
+ * constants, copied into this frame's memory (the frame before's is gone at
+ * the next capturing frame). 0 out of memory. */
+int d3d8_shaders_bake_again(D3D8Baked *b, const D3DMATRIX *const ff_m[3])
+{
+    if (!b->vsh) {
+        VSTransformConstants x = *(const VSTransformConstants *)b->ff_xf;
+        if (ff_m && !(x.flags & 0x01))
+            ff_xf_matrices(&x, ff_m[0], ff_m[1], ff_m[2]);
+        b->ff_xf = bake_block(&x, sizeof(x), &g_xf_captured);
+        b->ff_lt = bake_block(b->ff_lt, sizeof(VSLightingConstants), &g_lt_captured);
+        if (!b->ff_xf || !b->ff_lt)
+            return 0;
+    }
+    if (b->ps_cb == g_ps_cb)
+        b->ps_consts = bake_block(b->ps_consts, sizeof(PSConstants), &g_ps_captured);
+    else
+        b->ps_consts = d3d8_combiners_bake_again(b->ps_consts);
+    return b->ps_consts != NULL;
+}
+
 /* One constant buffer filled with `n` bytes from `p`. */
 static void cb_fill(ID3D11Buffer *cb, const void *p, size_t n)
 {
diff --git a/src/d3d/d3d8_vsh.c b/src/d3d/d3d8_vsh.c
index 9004278..0ed01a5 100644
--- a/src/d3d/d3d8_vsh.c
+++ b/src/d3d/d3d8_vsh.c
@@ -1180,6 +1180,49 @@ void d3d8_vsh_baked_consts(const D3D8Baked *b, const float *const *blk, BOOL fre
         memcpy((void *)g_vsh_baked_last, (const void *)blk, sizeof(g_vsh_baked_last));
 }
 
+/* Twoc step 95 (cut 3): a capture from the game frame before drawn again
+ * (d3d8_DrawBakedAgain): the program's constants (g_vsh_constants, as the
+ * caller's SetVertexShaderConstant calls left them) taken as a capturing
+ * draw takes them in d3d8_vsh_prepare_draw: into the ring unless the block
+ * there already holds them, bound in b1, and `b` told where for this
+ * frame's later passes (k_gen 0 without the ring: g_vsh_cb uploaded when
+ * dirty and bound, as before). */
+void d3d8_vsh_bake_again(D3D8Baked *b)
+{
+    ID3D11DeviceContext *ctx = d3d8_GetD3D11Context();
+    D3D11_MAPPED_SUBRESOURCE mapped;
+
+    b->k_gen = 0;
+    if (kring_ready()) {
+        if (!g_kring_cur_ok || g_kring_cur_gen != g_kring_gen) {
+            UINT off = kring_write(&g_vsh_constants);
+            if (off != (UINT)-1) {
+                g_kring_cur = off;
+                g_kring_cur_gen = g_kring_gen;
+                g_kring_cur_ok = TRUE;
+            }
+        }
+        if (g_kring_cur_ok && g_kring_cur_gen == g_kring_gen) {
+            kring_bind(g_kring_cur);
+            g_vsh_constants_dirty = TRUE;
+            g_vsh_baked_last[0] = NULL;
+            b->k_gen = g_kring_cur_gen;
+            b->k_first = g_kring_cur;
+            return;
+        }
+    }
+    if (g_vsh_constants_dirty) {
+        if (SUCCEEDED(ID3D11DeviceContext_Map(ctx, (ID3D11Resource *)g_vsh_cb, 0, D3D11_MAP_WRITE_DISCARD, 0,
+                                              &mapped))) {
+            memcpy(mapped.pData, &g_vsh_constants, sizeof(g_vsh_constants));
+            ID3D11DeviceContext_Unmap(ctx, (ID3D11Resource *)g_vsh_cb, 0);
+        }
+        g_vsh_constants_dirty = FALSE;
+        g_vsh_baked_last[0] = NULL;
+    }
+    d3d8_bind_vs_cb(ctx, 1, g_vsh_cb);
+}
+
 /* The frame's captures begin again (d3d8_BakeReset): a block given before
  * may be at the same address with other constants now. */
 void d3d8_vsh_bake_reset(void)
