-#define VSH_FIELD_CONST_IDX_START   13
-#define VSH_FIELD_CONST_IDX_SIZE    8
-#define VSH_FIELD_INPUT_IDX_START   9
-#define VSH_FIELD_INPUT_IDX_SIZE    4
-
-/* Source A (spans word 0 and word 1) */
