 src/d3d/d3d8_internal.h |  22 --------
 src/d3d/d3d8_shaders.c  | 117 +---------------------------------------
 src/d3d/d3d8_vsh.c      |  87 ++----------------------------
 4 files changed, 10 insertions(+), 234 deletions(-)

